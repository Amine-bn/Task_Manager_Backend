spring.application.name=task-manager-backend
server.port=8081

spring.datasource.url=jdbc:mysql://:3306/taskManager?createDatabaseIfNotExist=true
spring.jpa.hibernate.ddl-auto=update
spring.datasource.username=root
spring.datasource.password=

# Generate your own value, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Set via the JWT_SECRET environment variable — never commit a real value here.
app.secret-key=${JWT_SECRET}
app.expiration-time=86400000
